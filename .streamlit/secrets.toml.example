# Local run:  copy this file to .streamlit/secrets.toml and fill it in.
# Streamlit Community Cloud:  App > Settings > Secrets, paste the same text.
# NEVER commit the real secrets.toml (it is in .gitignore).

APP_PASSWORD = "choose-a-long-passphrase"            # the app will not start without it
OTHER_BRANDS = ""                                    # optional: extra names that must never appear in a brand's report, comma separated

[llm]
# Recommended free setup: Groq, a hosted open-weight model that can read images.
base_url = "https://api.groq.com/openai/v1"
api_key  = "paste-your-groq-key-here"
model    = "qwen/qwen3.8-27b"                        # vision model on Groq's free tier at the time of writing; check console.groq.com/docs/vision
vision   = true                                      # the model reads each template's image

# Backup (OpenRouter free models, smaller daily limit):
# base_url = "https://openrouter.ai/api/v1"
# model    = "google/gemma-4-31b-it:free"
# Local Ollama on your own machine (cannot be reached from Streamlit Cloud):
# base_url = "http://localhost:11434/v1"
# model    = "llama3.2-vision"    api_key = ""
