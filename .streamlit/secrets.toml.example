# Copy to .streamlit/secrets.toml for local runs. On Streamlit Community Cloud paste the same text into
# App settings > Secrets. NEVER commit the real secrets file.

APP_PASSWORD = "choose-a-long-passphrase"

[llm]
# Any OpenAI-compatible endpoint serving an open-source model.
# Examples: Groq, Together, Hugging Face router, or your own Ollama / vLLM server.
base_url = "https://api.groq.com/openai/v1"
api_key  = "put-the-key-here"
model    = "check-the-provider-list-for-the-current-model-name"
vision   = false          # true only if the model accepts images
